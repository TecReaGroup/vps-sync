# Local directory used as the upload source and download destination.
VPS_SYNC_LOCAL_DIRECTORY=E:/backup/project

# Remote directory. Absolute paths, relative paths, and ~/ paths are supported.
VPS_SYNC_REMOTE_DIRECTORY=~/backup/project

VPS_SYNC_HOST=203.0.113.10
VPS_SYNC_PORT=22
VPS_SYNC_USERNAME=root
VPS_SYNC_PASSWORD=replace-with-your-password

# Optional. Set a custom file or leave empty to use the user's default known-hosts file.
VPS_SYNC_KNOWN_HOSTS_FILE=

VPS_SYNC_CONNECTION_TIMEOUT_SECONDS=30
VPS_SYNC_LOG_LEVEL=INFO
